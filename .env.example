# ==========================================
# CẤU HÌNH MẪU CHO SOAR SIMULATOR
# (Đổi tên file này thành .env để chạy hệ thống)
# ==========================================

# 1. Cấu hình Server & DB
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://host.docker.internal:27017/soar_db

# 2. Mã bí mật JWT (Người dùng tự điền 1 chuỗi bí mật bất kỳ)
JWT_SECRET=your_jwt_secret_key_here

# 3. Mã bí mật Webhook kết nối n8n
WEBHOOK_SECRET=mock_soar_secret_123

# 4. Địa chỉ n8n SOAR
N8N_LOCAL_URL=http://host.docker.internal:5678

# 5. Cấu hình gửi Mail cảnh báo (Nếu muốn test luồng gửi Gmail thật)
# Lấy App Password tại: https://myaccount.google.com/apppasswords
MANAGER_EMAIL=your_admin_email@gmail.com
EMAIL_USER=your_gmail_to_send@gmail.com
EMAIL_PASS=your_16_character_app_password

# 6. Cấu hình Frontend
VITE_API_URL=http://localhost:3000/api/v1